Relais:

  - name: 230V_relais_1_an
    bedingungen:
      - tonlaut: [tv, fernseher, fernseh, glotze, videokiste]
      - tonlaut: [aktivieren, positiv, eins, an, ein, hell, einschalten, anschalten, zuschalten]
    aktionen:
      - command: "/Energiebox/230V/230V 1 1 0"
      - speak: "  Fernseher wurde eingeschaltet!"
  - name: 230V_relais_1_aus
